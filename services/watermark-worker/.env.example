# Copy this file to services/watermark-worker/.env for a worker process only.
# Do not load it into Next.js, commit .env, or reuse browser credentials here.
# WORKER_CONVEX_TOKEN must exactly match the server-side WORKER_TOKEN on the
# selected Convex deployment. Profile secrets are worker-local and must never
# appear in a Convex mutation, artifact, browser environment, or log.

WORKER_CONVEX_URL=https://your-deployment.convex.cloud
WORKER_CONVEX_TOKEN=replace-with-the-matching-server-worker-token
WORKER_ID=local-watermark-worker-1
WORKER_CAPABILITIES=cpu
WORKER_VERSION=watermark-worker-v0.1

# Demo fixture profiles, when devBootstrap has installed them. Generate a
# distinct non-empty base64 key in your secret manager; these placeholders are
# intentionally invalid and do not provide a usable watermark key.
WORKER_PROFILE_DEMO_IMAGE_V1_SECRET_BASE64=replace-with-base64-profile-secret
WORKER_PROFILE_DEMO_IMAGE_V1_VERSION=1.0.0
WORKER_PROFILE_DEMO_IMAGE_V1_KEY_VERSION=demo-key-v1
WORKER_PROFILE_DEMO_IMAGE_V1_STRENGTH=0.12
WORKER_PROFILE_DEMO_IMAGE_V1_TILE_SIZE=256

WORKER_PROFILE_DEMO_SCREEN_V1_SECRET_BASE64=replace-with-base64-profile-secret
WORKER_PROFILE_DEMO_SCREEN_V1_VERSION=1.0.0
WORKER_PROFILE_DEMO_SCREEN_V1_KEY_VERSION=demo-key-v1
WORKER_PROFILE_DEMO_SCREEN_V1_STRENGTH=0.12
WORKER_PROFILE_DEMO_SCREEN_V1_TILE_SIZE=256

# Optional daemon controls. The run command is the container default.
WORKER_IDLE_POLL_SECONDS=5
WORKER_FAILURE_BACKOFF_SECONDS=5
WORKER_MAX_FAILURE_BACKOFF_SECONDS=60
WORKER_MAX_CONSECUTIVE_FAILURES=5
