# Convex deployment URL for the Next.js client and external worker
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=
CONVEX_DEPLOYMENT=
# Convex HTTP action URL (when HTTP actions are added)
CONVEX_SITE_URL=
# Worker service credential; set remotely with `npx convex env set WORKER_TOKEN`
WORKER_TOKEN=
# WorkOS AuthKit: the client ID is safe for the browser; the API key and cookie
# password must only be set on the Next.js server/host. Configure the client ID
# independently on each Convex deployment as WORKOS_CLIENT_ID before deploying.
NEXT_PUBLIC_WORKOS_AUTH_ENABLED=false
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/callback
