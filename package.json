{
  "name": "traceanytong",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@traceanytong/web",
    "build": "npm run build --workspace=@traceanytong/web",
    "test": "npm run test --workspaces --if-present",
    "test:convex": "tsc --noEmit -p convex/tsconfig.json",
    "test:worker": "python -m pytest services/watermark-worker/tests -q",
    "bench": "python -m bench.runners.run --fixtures bench/fixtures --output bench/reports/latest"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "convex": "^1.25.4",
    "typescript": "5.8.3"
  }
}
